# Copy to .env and fill in. .env is gitignored.

# Which model does the vision extraction. Any ruby_llm-supported id works;
# the provider is inferred from the id, so switching is a one-line change.
#   gemini-3.5-flash  vision + structured output, low cost (default)
#   gpt-4o            OpenAI alternative
LLM_MODEL=gemini-3.5-flash

# ruby_llm validates model ids against a registry bundled with the gem, so a
# model released after your installed version is rejected before any request is
# made. Naming the provider skips that check -- set this to use a newer model,
# e.g. LLM_PROVIDER=gemini with LLM_MODEL=gemini-3.6-flash.
# LLM_PROVIDER=gemini

# Only the key for the provider you actually use is required.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Seconds to wait on a single vision call before giving up and retrying.
LLM_TIMEOUT=60
