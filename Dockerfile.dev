# Development image. The production Dockerfile generated by Rails stays as-is.
FROM ruby:3.4-slim

ENV RAILS_ENV=development \
    BUNDLE_PATH=/usr/local/bundle \
    LANG=C.UTF-8

# libpq for the pg gem; libvips for ActiveStorage variants; git for git-sourced gems
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential libpq-dev libvips postgresql-client git curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Cache the bundle layer: only re-runs when the Gemfile changes
COPY Gemfile Gemfile.lock* ./
RUN gem install bundler -v 2.6.9 --no-document && \
    bundle install --jobs 4 --retry 3

COPY . .

EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]
